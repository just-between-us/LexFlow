@page "/documents/{id:guid}/edit"
@attribute [Authorize]
@using lex.Application.DTOs
@using Lex.Domain.Enums
@using lex.Application.Interfaces
@using Lex.Components.Auth
@using Lex.Components.Shared
@using Lex.Components.Utils
@using Microsoft.AspNetCore.Authorization
@using Markdig
@inject IDocumentEditingService DocumentEditingService
@inject UserContext UserContext
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Navigation

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-8">
    @if (_isLoading)
    {
        <MudSkeleton Width="60%" Height="40px" Class="mb-2" />
        <MudSkeleton Width="30%" Height="24px" Class="mb-6" />
        <MudGrid>
            <MudItem xs="12" md="6"><MudSkeleton Width="100%" Height="480px" Class="rounded-lg" /></MudItem>
            <MudItem xs="12" md="6"><MudSkeleton Width="100%" Height="480px" Class="rounded-lg" /></MudItem>
        </MudGrid>
    }
    else if (_document == null)
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">
            Документ не найден или у вас нет прав на редактирование.
        </MudAlert>
    }
    else
    {
        <!-- Заголовок -->
        <div class="d-flex align-start justify-space-between mb-6 flex-wrap gap-3">
            <div>
                <MudText Typo="Typo.h4">Редактирование документа</MudText>
                <MudText Typo="Typo.body1" Class="text-muted mt-1">@_document.Title</MudText>

                <div class="d-flex align-center gap-2 flex-wrap mt-2">
                    <MudTooltip Text="@DisplayHelper.GetStatusDescription(_document.Status)">
                        <MudChip T="string" Size="Size.Small" Color="@DisplayHelper.GetStatusColor(_document.Status)" Variant="Variant.Filled">
                            @DisplayHelper.GetStatusDisplayName(_document.Status)
                        </MudChip>
                    </MudTooltip>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@DisplayHelper.GetTypeColor(_document.Type)" >
                        @DisplayHelper.GetTypeDisplayName(_document.Type)
                    </MudChip>
                    <MudTooltip Text="Номер версии, которая сейчас считается основной для документа">
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Icon="@Icons.Material.Filled.Bookmark">
                            Актуальная: v@(_document.CurrentVersionNumber)
                        </MudChip>
                    </MudTooltip>
                    @if (_hasUnsavedChanges)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Text"
                                 Icon="@Icons.Material.Filled.FiberManualRecord" Class="pulse-chip">
                            Есть несохранённые изменения
                        </MudChip>
                    }
                </div>

                @if (_document.TemplateId != null)
                {
                    <MudText Typo="Typo.caption" Class="text-muted d-flex align-center gap-1 mt-2">
                        <MudIcon Icon="@Icons.Material.Filled.LibraryBooks" Size="Size.Small" />
                        Создан на основе шаблона —
                        <a href="@($"/templates/view/{_document.TemplateId}")" class="text-primary">открыть шаблон</a>
                    </MudText>
                }
            </div>

            <div class="d-flex gap-2">
                <MudTooltip Text="Вернуться к просмотру без сохранения">
                    <MudButton Variant="Variant.Text" Color="Color.Secondary"
                               StartIcon="@Icons.Material.Filled.Visibility"
                               Href="@($"/documents/{Id}")">
                        Просмотр
                    </MudButton>
                </MudTooltip>
                <MudTooltip Text="@($"Всего версий: {_document.Versions.Count}. Открыть историю")">
                    <MudIconButton Icon="@Icons.Material.Filled.History"
                                   Color="Color.Inherit"
                                   OnClick="@ToggleVersionPanel" />
                </MudTooltip>
            </div>
        </div>

        <MudGrid>
            <MudItem xs="12" md="6">
                <!-- Метаданные -->
                <MudCard Elevation="1" Class="mb-4 section-card">
                    <MudCardContent>
                        <MudText Typo="Typo.h6" Class="mb-1 d-flex align-center gap-1">
                            <MudIcon Icon="@Icons.Material.Filled.Description" Size="Size.Small" />
                            Основная информация 
                        </MudText>
                        <MudText Typo="Typo.caption" Class="text-muted mb-4">
                            Название и описание видны в каталоге и списках документов
                        </MudText>

                        <MudTextField @bind-Value="_editTitle" Label="Название" Required="true"
                                      T="string" Variant="Variant.Outlined"
                                      MaxLength="200" Counter="200"
                                      HelperText="Кратко и по делу — станет заголовком документа"
                                      Immediate="true" OnKeyUp="(e) => MarkChanged()" Class="mb-4" />

                        <MudTextField @bind-Value="_editDescription" Label="Описание"
                                      Lines="2" T="string" Variant="Variant.Outlined"
                                      MaxLength="2000" Counter="2000"
                                      HelperText="Необязательно — краткая аннотация для документа"
                                      Immediate="true" OnKeyUp="(e) => MarkChanged()" />
                    </MudCardContent>
                </MudCard>

                <!-- Статус и классификация -->
                <MudCard Elevation="1" Class="mb-4 section-card">
                    <MudCardContent>
                        <MudText Typo="Typo.h6" Class="mb-1 d-flex align-center gap-1">
                            <MudIcon Icon="@Icons.Material.Filled.Tune" Size="Size.Small" />
                            Статус и классификация
                        </MudText>
                        <MudText Typo="Typo.caption" Class="text-muted mb-4">
                            Влияет на то, где и кому виден документ
                        </MudText>

                        <MudTooltip Text="@DisplayHelper.GetStatusDescription(_editStatus)" Placement="Placement.Top" RootClass="d-block mb-4">
                            <MudSelect Value="_editStatus"
                                       ValueChanged="OnStatusChanged"
                                       Label="Статус документа" T="DocumentStatus"
                                       Variant="Variant.Outlined"
                                       AdornmentIcon="@Icons.Material.Filled.HelpOutline" Adornment="Adornment.End">
                                @foreach (var status in SelectableStatuses)
                                {
                                    <MudSelectItem Value="status">
                                        <div class="d-flex align-center gap-2">
                                            <div class="status-dot" style="@GetStatusDotStyle(status)"></div>
                                            @DisplayHelper.GetStatusDisplayName(status)
                                        </div>
                                    </MudSelectItem>
                                }
                            </MudSelect>
                        </MudTooltip>

                        @if (_editStatus == DocumentStatus.Archived && _document.Status != DocumentStatus.Archived)
                        {
                            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-4" Icon="@Icons.Material.Filled.Inventory2">
                                После сохранения документ пропадёт из активных списков, но останется доступен по ссылке
                            </MudAlert>
                        }
                        @if (_editStatus == DocumentStatus.Signed && _document.Status != DocumentStatus.Signed)
                        {
                            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-4" Icon="@Icons.Material.Filled.Verified">
                                Дата подписания будет зафиксирована текущим моментом
                            </MudAlert>
                        }

                        <MudSelect Value="_editType"
                                   ValueChanged="(v) => { _editType = v; MarkChanged(); }"
                                   Label="Тип документа" T="DocumentType"
                                   Variant="Variant.Outlined"
                                   Class="mb-4">
                            @foreach (var type in Enum.GetValues<DocumentType>())
                            {
                                <MudSelectItem Value="type">@DisplayHelper.GetTypeDisplayName(type)</MudSelectItem>
                            }
                        </MudSelect>

                        <MudTooltip Text="Определяет, кто ещё сможет увидеть этот документ" Placement="Placement.Top" RootClass="d-block">
                            <MudSelect Value="_editPrivacy"
                                       ValueChanged="(v) => { _editPrivacy = v; MarkChanged(); }"
                                       Label="Видимость" T="DocumentPrivacy"
                                       Variant="Variant.Outlined"
                                       AdornmentIcon="@Icons.Material.Filled.HelpOutline" Adornment="Adornment.End">
                                @foreach (var p in Enum.GetValues<DocumentPrivacy>())
                                {
                                    <MudSelectItem Value="p">@DisplayHelper.GetPrivacyDisplayName(p)</MudSelectItem>
                                }
                            </MudSelect>
                        </MudTooltip>
                    </MudCardContent>
                </MudCard>

                <!-- Содержимое -->
                <MudCard Elevation="1" Class="mb-4 section-card">
                    <MudCardContent>
                        <div class="d-flex align-center justify-space-between mb-1">
                            <MudText Typo="Typo.h6" Class="d-flex align-center gap-1">
                                <MudIcon Icon="@Icons.Material.Filled.Article" Size="Size.Small" />
                                Содержимое
                            </MudText>
                            <MudTooltip Text="Поддерживается Markdown: **жирный**, *курсив*, списки, таблицы, ссылки">
                                <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Class="text-muted" />
                            </MudTooltip>
                        </div>
                        <MudText Typo="Typo.caption" Class="text-muted mb-4">
                            Редактируется @(_editingVersion is not null ? $"версия v{_editingVersion.VersionNumber}" : "")
                            @if (_editingVersion?.VersionNumber != _document.CurrentVersionNumber)
                            {
                                <span class="text-warning"> — это не актуальная версия</span>
                            }
                        </MudText>

                        <MudTextField @key="@(_editingVersion?.Id ?? Guid.Empty)"
                                      @bind-Value="_editContent" Label="Markdown"
                                      Lines="15" T="string" Variant="Variant.Outlined"
                                      MaxLength="150000" Counter="150000"
                                      Immediate="true" OnKeyUp="(e) => MarkChanged()" />
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudCard Elevation="1" Class="preview-card section-card">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6" Class="d-flex align-center gap-1">
                                <MudIcon Icon="@Icons.Material.Filled.RemoveRedEye" Size="Size.Small" />
                                Предпросмотр
                            </MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent Class="markdown-preview">
                        @if (string.IsNullOrWhiteSpace(_editContent))
                        {
                            <div class="text-center py-8">
                                <MudIcon Icon="@Icons.Material.Filled.EditNote" Size="Size.Large" Class="mb-2 text-muted" />
                                <MudText Typo="Typo.body2" Class="text-muted">Начните вводить текст слева — предпросмотр появится здесь</MudText>
                            </div>
                        }
                        else
                        {
                            @((MarkupString)RenderMarkdown(_editContent))
                        }
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>

        <!-- Панель действий -->
        <div class="d-flex flex-wrap align-center gap-2 sticky-actions pa-3 rounded-lg mt-4">
            <MudTooltip Text="Сохранить изменения — вы выберете, обновить текущую версию или создать новую">
                <MudButton Variant="Variant.Filled"
                           Color="@(_saveState == SaveState.Success ? Color.Success : Color.Primary)"
                           OnClick="Save"
                           Disabled="@(!_hasUnsavedChanges || _isSaving)"
                           Class="save-button">
                    @if (_saveState == SaveState.Saving)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        <span>Сохранение...</span>
                    }
                    else if (_saveState == SaveState.Success)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" Class="mr-1" />
                        <span>Сохранено</span>
                    }
                    else
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Save" Size="Size.Small" Class="mr-1" />
                        <span>Сохранить</span>
                    }
                </MudButton>
            </MudTooltip>

            <MudTooltip Text="Текущая версия останется без изменений, создастся новая на основе введённого текста">
                <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                           OnClick="SaveAsNewVersion"
                           StartIcon="@Icons.Material.Filled.Add"
                           Disabled="@(!_hasUnsavedChanges || _isSaving)">
                    Сохранить как новую версию
                </MudButton>
            </MudTooltip>

            <MudSpacer />

            @if (_hasUnsavedChanges && !_isSaving)
            {
                <MudText Typo="Typo.caption" Class="text-muted mr-2">Изменения не сохранены</MudText>
            }

            <MudButton Variant="Variant.Text" Color="Color.Secondary" OnClick="Cancel">
                Отмена
            </MudButton>
        </div>
    }
</MudContainer>

<!-- Панель версий -->
@if (_versionPanelVisible)
{
    <div class="version-panel-overlay" @onclick="CloseVersionPanel">
        <div class="version-panel" @onclick:stopPropagation="true">
            <div class="d-flex align-center justify-space-between pa-3 border-bottom">
                <div>
                    <MudText Typo="Typo.h6">История версий</MudText>
                    <MudText Typo="Typo.caption" Class="text-muted">@_document!.Versions.Count версий всего</MudText>
                </div>
                <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="@CloseVersionPanel" Size="Size.Small" />
            </div>
            <div class="version-list-container px-2 py-2">
                @foreach (var version in _document.Versions)
                {
                    var isCurrent = version.VersionNumber == _document.CurrentVersionNumber;
                    var isEditing = version.Id == _editingVersion?.Id;

                    <div class="version-item @(isEditing ? "version-item-active" : "")" @onclick="@(() => SelectVersion(version))">
                        <MudAvatar Size="Size.Small" Color="@(isCurrent ? Color.Primary : Color.Default)">
                            v@(version.VersionNumber)
                        </MudAvatar>
                        <div class="flex-grow-1">
                            <div class="d-flex align-center gap-1 flex-wrap">
                                <MudText Typo="Typo.body2">@version.CreatedByName</MudText>
                                @if (isCurrent)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Text">Актуальная</MudChip>
                                }
                            </div>
                            @if (!string.IsNullOrWhiteSpace(version.ChangeSummary))
                            {
                                <MudText Typo="Typo.caption" Class="text-muted d-block text-truncate" Style="max-width: 260px;">
                                    @version.ChangeSummary
                                </MudText>
                            }
                            <MudText Typo="Typo.caption" Class="text-muted">@DisplayHelper.GetRelativeTime(version.CreatedAtUtc)</MudText>
                        </div>
                        @if (isEditing)
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary" />
                        }
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private DocumentEditDto? _document;
    private DocumentVersionSummaryDto? _editingVersion;
    private bool _isLoading = true;
    private bool _isSaving;
    private bool _hasUnsavedChanges;
    private bool _versionPanelVisible;
    private Guid? _currentUserId;
    private SaveState _saveState = SaveState.Idle;
    private enum SaveState { Idle, Saving, Success }

    private string _editTitle = "";
    private string _editDescription = "";
    private DocumentType _editType;
    private DocumentPrivacy _editPrivacy;
    private DocumentStatus _editStatus;
    private string _editContent = "";

    private static readonly DocumentStatus[] SelectableStatuses =
        Enum.GetValues<DocumentStatus>().Where(s => s != DocumentStatus.Deleted).ToArray();

    protected override async Task OnInitializedAsync()
    {
        _currentUserId = Guid.TryParse(UserContext.CurrentUser?.UserId, out var uid) ? uid : null;
        if (!_currentUserId.HasValue) { _isLoading = false; return; }
        await LoadDocument();
    }

    private async Task LoadDocument()
    {
        _isLoading = true;
        StateHasChanged();
        try
        {
            _document = await DocumentEditingService.GetForEditingAsync(Id, _currentUserId!.Value);
            if (_document is null) return;

            _editingVersion = _document.Versions.FirstOrDefault(v => v.VersionNumber == _document.CurrentVersionNumber)
                               ?? _document.Versions.FirstOrDefault();

            _editContent = _editingVersion?.Content ?? string.Empty;
            _editTitle = _document.Title;
            _editDescription = _document.Description;
            _editType = _document.Type;
            _editPrivacy = _document.Privacy;
            _editStatus = _document.Status;
            _hasUnsavedChanges = false;
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private void MarkChanged()
    {
        _hasUnsavedChanges = true;
        if (_saveState == SaveState.Success) _saveState = SaveState.Idle;
    }

    private void OnStatusChanged(DocumentStatus value)
    {
        _editStatus = value;
        MarkChanged();
    }

    private void SelectVersion(DocumentVersionSummaryDto version)
    {
        _hasUnsavedChanges = false;
        _editingVersion = version;
        _editContent = version.Content;
        _versionPanelVisible = false;
    }

    private void ToggleVersionPanel() => _versionPanelVisible = !_versionPanelVisible;
    private void CloseVersionPanel() => _versionPanelVisible = false;

    private async Task Save()
    {
        if (!_hasUnsavedChanges || _document is null) return;

        var parameters = new DialogParameters<SaveVersionDialog>
        {
            { x => x.EditingVersionNumber, _editingVersion?.VersionNumber ?? 0 },
            { x => x.IsLatestVersion, _editingVersion?.VersionNumber == _document.CurrentVersionNumber },
            { x => x.HasDocumentFieldChanges, HasDocumentFieldChanges() }
        };
        var dialog = await DialogService.ShowAsync<SaveVersionDialog>("Сохранение версии", parameters);
        var result = await dialog.Result;
        if (result.Canceled) return;

        if (result.Data is not SaveVersionResult saveResult) return;

        if (saveResult.CreateNewVersion)
            await CreateNewVersion(saveResult.ChangeSummary);
        else
            await UpdateExistingVersion(saveResult.ChangeSummary);
    }

    private async Task SaveAsNewVersion()
    {
        if (_document is null) return;

        var parameters = new DialogParameters<SaveVersionDialog>
        {
            { x => x.EditingVersionNumber, _editingVersion?.VersionNumber ?? 0 },
            { x => x.IsLatestVersion, _editingVersion?.VersionNumber == _document.CurrentVersionNumber },
            { x => x.HasDocumentFieldChanges, HasDocumentFieldChanges() },
            { x => x.ForceNewVersion, true }
        };
        var dialog = DialogService.Show<SaveVersionDialog>("Сохранение версии", parameters);
        var result = await dialog.Result;
        if (result.Canceled) return;

        if (result.Data is SaveVersionResult { CreateNewVersion: true } saveResult)
            await CreateNewVersion(saveResult.ChangeSummary);
        else
            Snackbar.Add("Неверный выбор", Severity.Warning);
    }

    private DocumentFieldsUpdateModel BuildFieldsModel() => new()
    {
        Title = _editTitle,
        Description = _editDescription,
        Type = _editType,
        Privacy = _editPrivacy,
        Status = _editStatus
    };

    private async Task CreateNewVersion(string? changeSummary)
    {
        if (_document is null || _currentUserId is null) return;
        _saveState = SaveState.Saving;
        _isSaving = true;
        StateHasChanged();
        try
        {
            _document = await DocumentEditingService.CreateNewVersionAsync(
                _document.Id, _currentUserId.Value, _editingVersion?.VersionNumber ?? 0,
                BuildFieldsModel(), _editContent, changeSummary);

            Snackbar.Add($"Создана новая версия v{_document.CurrentVersionNumber}", Severity.Success);
            FinishSave(_document.Versions.First(v => v.VersionNumber == _document.CurrentVersionNumber));
        }
        catch (Exception ex)
        {
            _saveState = SaveState.Idle;
            Snackbar.Add($"Ошибка сохранения: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSaving = false;
            StateHasChanged();
        }
    }

    private async Task UpdateExistingVersion(string? changeSummary)
    {
        if (_document is null || _currentUserId is null || _editingVersion is null) return;
        _saveState = SaveState.Saving;
        _isSaving = true;
        StateHasChanged();
        try
        {
            var versionId = _editingVersion.Id;
            _document = await DocumentEditingService.UpdateExistingVersionAsync(
                _document.Id, _currentUserId.Value, versionId,
                BuildFieldsModel(), _editContent, changeSummary);

            Snackbar.Add($"Версия v{_editingVersion.VersionNumber} обновлена", Severity.Success);
            FinishSave(_document.Versions.First(v => v.Id == versionId));
        }
        catch (Exception ex)
        {
            _saveState = SaveState.Idle;
            Snackbar.Add($"Ошибка сохранения: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSaving = false;
            StateHasChanged();
        }
    }

    private async void FinishSave(DocumentVersionSummaryDto updatedVersion)
    {
        _hasUnsavedChanges = false;
        _editingVersion = updatedVersion;
        _editContent = updatedVersion.Content;
        _saveState = SaveState.Success;
        StateHasChanged();

        await Task.Delay(1600);
        if (_saveState == SaveState.Success) _saveState = SaveState.Idle;
        StateHasChanged();
    }

    private bool HasDocumentFieldChanges() =>
        _document != null &&
        (_editTitle != _document.Title ||
         _editDescription != _document.Description ||
         _editType != _document.Type ||
         _editPrivacy != _document.Privacy ||
         _editStatus != _document.Status);

    private void Cancel() => Navigation.NavigateTo($"/documents/{Id}");

    private static string RenderMarkdown(string markdown)
    {
        var pipeline = new MarkdownPipelineBuilder().UseAdvancedExtensions().Build();
        return Markdown.ToHtml(markdown ?? string.Empty, pipeline);
    }

    private static string GetStatusDotStyle(DocumentStatus status)
    {
        var color = DisplayHelper.GetStatusColor(status);
        return $"background-color: var(--mud-palette-{color.ToString().ToLowerInvariant()});";
    }
}