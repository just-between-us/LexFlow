@using lex.Application.DTOs
@using lex.Application.Interfaces
@using Lex.Domain.Enums
@using Lex.Components.Auth
@using Lex.Components.Shared
@using Lex.Components.Utils
@implements IDisposable
@inject IDocumentService DocumentService
@inject UserContext UserContext
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Navigation

<div class="py-4">
    <PageTitle>Мои документы</PageTitle>
</div>
<div class="documents-page">
    <div class="d-flex align-center justify-space-between mb-4 flex-wrap gap-2 pr-8">
        <div>
            <MudText Typo="Typo.h4">Мои документы</MudText>
            <MudText Typo="Typo.body2" Class="text-muted">
                Управление созданными вами документами
            </MudText>
        </div>
        <MudSpacer/>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   Href="/templates" Class="rounded-lg">
            Создать
        </MudButton>
    </div>

    <!-- Панель управления -->
    <MudPaper Class="pa-4 mb-3 rounded-lg toolbar-panel" Elevation="0">
        <MudStack Row="true" Spacing="2" Class="align-center flex-wrap">

            <MudTextField @bind-Value="_searchQuery"
                          Label="Поиск"
                          Placeholder="Название или описание..."
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Immediate="true"
                          DebounceInterval="350"
                          OnDebounceIntervalElapsed="OnSearchDebounced"
                          OnKeyUp="OnSearchKeyUp"
                          Clearable="true"
                          OnClearButtonClick="@(() => OnSearchCleared())"
                          Variant="Variant.Outlined"
                          Class="flex-grow-1"
                          Style="min-width: 220px;"/>

            <MudSelect T="DocumentStatus?"
                       Label="Статус"
                       Value="_filterStatus"
                       Variant="Variant.Outlined"
                       Class="flex-shrink-0"
                       Style="min-width: 160px;"
                       ValueChanged="OnStatusFilterChanged">
                <MudSelectItem Value="@((DocumentStatus?)null)">Все статусы</MudSelectItem>
                @foreach (var s in Enum.GetValues<DocumentStatus>())
                {
                    <MudSelectItem Value="@((DocumentStatus?)s)">
                        @DisplayHelper.GetStatusDisplayName(s)
                    </MudSelectItem>
                }
            </MudSelect>

            <MudSelect T="DocumentPrivacy?"
                       Label="Видимость"
                       Value="_filterPrivacy"
                       Variant="Variant.Outlined"
                       Class="flex-shrink-0"
                       Style="min-width: 160px;"
                       ValueChanged="OnPrivacyFilterChanged">
                <MudSelectItem Value="@((DocumentPrivacy?)null)">Все</MudSelectItem>
                @foreach (var p in Enum.GetValues<DocumentPrivacy>())
                {
                    <MudSelectItem Value="@((DocumentPrivacy?)p)">
                        @DisplayHelper.GetPrivacyDisplayName(p)
                    </MudSelectItem>
                }
            </MudSelect>

            <MudDivider Vertical="true" Class="mx-1 d-none d-md-flex" />

            <MudTooltip Text="Что показывать">
                <MudMenu Label="@GetLifecycleLabel()"
                         Icon="@Icons.Material.Filled.FilterAlt"
                         EndIcon="@Icons.Material.Filled.ArrowDropDown"
                         Variant="Variant.Text"
                         Class="flex-shrink-0 rounded-button-hover-scale">
                    @foreach (var (filter, label, icon) in LifecycleOptions)
                    {
                        <MudMenuItem OnClick="@(() => SetLifecycleFilter(filter))">
                            <span class="d-flex align-center">
                                <MudIcon Icon="@icon" Size="Size.Small" Class="mr-2" />
                                @label
                                @if (_lifecycleFilter == filter)
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" Class="ml-2" />
                                }
                            </span>
                        </MudMenuItem>
                    }
                </MudMenu>
            </MudTooltip>
            
            <MudTooltip Text="Порядок отображения">
                <MudMenu Label="@GetSortLabel()"
                         Icon="@Icons.Material.Filled.Sort"
                         EndIcon="@Icons.Material.Filled.ArrowDropDown"
                         Variant="Variant.Text"
                         Class="flex-shrink-0 rounded-button-hover-scale">
                    @foreach (var (field, label) in SortOptions)
                    {
                        <MudMenuItem OnClick="@(() => SetSort(field))">
                            <span class="d-flex align-center">
                                @label
                                @if (IsCurrentSort(field))
                                {
                                    <MudIcon Icon="@GetDirectionIcon()" Size="Size.Small" Class="ml-2" />
                                }
                            </span>
                        </MudMenuItem>
                    }
                </MudMenu>
            </MudTooltip>

            <MudTooltip Text="@(_sortAscending ? "По возрастанию" : "По убыванию")">
                <div Class="rounded-button-hover-scale">
                    <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward"
                                   OnClick="@ToggleSortDirection"
                                   Style="@ArrowRotationStyle"
                                   Variant="Variant.Text"/>
                </div>
            </MudTooltip>

            <MudTooltip Text="Обновить">
                <div Class="rounded-button-hover-scale">
                    <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                                   OnClick="@OnRefreshClick"
                                   Disabled="@_isRefreshing"
                                   Style="@RefreshSpinStyle"
                                   Variant="Variant.Text"/>
                </div>
            </MudTooltip>

            <MudSpacer />

            <MudChip T="string" Size="Size.Medium" Color="Color.Primary" Variant="Variant.Text">
                @(_totalCount == 0 ? "Ничего не найдено" : $"Найдено: {_totalCount}")
            </MudChip>
        </MudStack>

        @if (HasActiveFilters)
        {
            <MudStack Row="true" Spacing="1" Class="mt-3 flex-wrap align-center">
                <MudText Typo="Typo.caption" Class="text-muted mr-1">Фильтры:</MudText>
                @if (!string.IsNullOrWhiteSpace(_searchQuery))
                {
                    <MudChip T="string" Size="Size.Small" OnClose="@(() => OnSearchCleared())">
                        "@_searchQuery"
                    </MudChip>
                }
                @if (_filterStatus.HasValue)
                {
                    <MudChip T="string" Size="Size.Small" OnClose="@(() => ClearStatusFilter())">
                        @DisplayHelper.GetStatusDisplayName(_filterStatus.Value)
                    </MudChip>
                }
                @if (_filterPrivacy.HasValue)
                {
                    <MudChip T="string" Size="Size.Small" OnClose="@(() => ClearPrivacyFilter())">
                        @DisplayHelper.GetPrivacyDisplayName(_filterPrivacy.Value)
                    </MudChip>
                }
                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@ResetFilters">
                    Сбросить всё
                </MudButton>
            </MudStack>
        }
    </MudPaper>

    <!-- Список документов -->
    @if (_isLoading)
    {
        <MudGrid>
            @for (int i = 0; i < _pageSize; i++)
            {
                <MudItem xs="12" sm="6" lg="4">
                    <MudPaper Class="pa-4 rounded-lg" Style="height: 230px;">
                        <MudSkeleton Width="70%" Height="28px" Class="mb-2" />
                        <MudSkeleton Width="40%" Height="20px" Class="mb-4" />
                        <MudSkeleton Width="100%" Height="16px" />
                        <MudSkeleton Width="90%" Height="16px" Class="mb-3" />
                        <MudSkeleton Width="50%" Height="16px" />
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>
    }
    else if (!_documents.Any())
    {
        <MudPaper Class="pa-8 rounded-lg text-center" Elevation="0" Style="background: var(--mud-palette-background-grey);">
            <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" Class="mb-2 text-muted" />
            <MudText Typo="Typo.h6" Class="mb-1">@GetEmptyStateTitle()</MudText>
            <MudText Typo="Typo.body2" Class="text-muted mb-3">
                @(HasActiveFilters ? "Попробуйте изменить поиск или фильтры" : "")
            </MudText>
            @if (HasActiveFilters)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@ResetFilters">
                    Сбросить фильтры
                </MudButton>
            }
        </MudPaper>
    }
    else
    {
        <MudGrid>
            @foreach (var doc in _documents)
            {
                <DocumentCard Document="doc"
                              OnOpen="OpenDocument"
                              OnEdit="EditDocument"
                              OnToggleArchive="ArchiveDocument"
                              OnDelete="DeleteDocument" 
                              OnRestore="RestoreDocument" />
            }
        </MudGrid>

        <!-- Пагинация -->
        <div class="d-flex flex-column align-center mt-4 gap-2">
            <MudPagination Selected="@_currentPage"
                           Count="@_totalPages"
                           SelectedChanged="@OnPaginationChanged"
                           Size="Size.Medium"
                           Color="Color.Primary" />
            <MudText Typo="Typo.caption" Class="text-muted">
                Показано @Math.Min((_currentPage - 1) * _pageSize + 1, _totalCount)–@Math.Min(_currentPage * _pageSize, _totalCount) из @_totalCount
            </MudText>
        </div>
    }
</div>

@code {
    private bool _isAuthorized;
    private Guid? _currentUserId;
    private List<DocumentSummaryDto> _documents = new();
    private bool _isLoading = true;
    private bool _isRefreshing;
    private int MinSpinMs = 600;
    private int _currentPage = 1;
    private int _totalPages = 1;
    private int _totalCount;
    private readonly int _pageSize = 12;
    private DocumentLifecycleFilter _lifecycleFilter = DocumentLifecycleFilter.NotDeleted;
    private DocumentStatus? _filterStatus;
    private DocumentPrivacy? _filterPrivacy;
    private string _searchQuery = string.Empty;
    private string _sortField = "Date";
    private bool _sortAscending;
    private CancellationTokenSource? _loadCts;
    private static readonly (string Field, string Label)[] SortOptions =
    [
        ("Date", "По дате"),
        ("Title", "По названию"),
        ("Status", "По статусу"),
        ("Type", "По типу")
    ];

    private bool HasActiveFilters => !string.IsNullOrWhiteSpace(_searchQuery) || _filterStatus.HasValue || _filterPrivacy.HasValue;

    
    private async Task OnRefreshClick()
    {
        if (_isRefreshing) return;

        _isRefreshing = true;
        StateHasChanged();

        var sw = System.Diagnostics.Stopwatch.StartNew();
        await LoadData();

        var remaining = MinSpinMs - (int)sw.ElapsedMilliseconds;
        if (remaining > 0)
            await Task.Delay(remaining);

        _isRefreshing = false;
        StateHasChanged();
    }
    
    private string ArrowRotationStyle =>
        $"transform: rotate({(_sortAscending ? 0 : 180)}deg); " +
        "transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);";

    private string RefreshSpinStyle =>
        $"transform: rotate({(_isRefreshing ? 360 : 0)}deg); " +
        "transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);";

    protected override async Task OnInitializedAsync()
    {
        _currentUserId = Guid.TryParse(UserContext.CurrentUser?.UserId, out var uid) ? uid : null;
        _isAuthorized = _currentUserId.HasValue && UserContext.IsAuthenticated;
        if (_isAuthorized)
            await LoadData();
        else
            _isLoading = false;
    }

    private async Task LoadData()
    {
        _loadCts?.Cancel();
        _loadCts = new CancellationTokenSource();
        var ct = _loadCts.Token;

        _isLoading = true;
        StateHasChanged();

        try
        {
            var (items, total) = await DocumentService.GetMyDocumentsAsync(
                userId: _currentUserId!.Value,
                searchTerm: _searchQuery,
                status: _filterStatus,
                privacy: _filterPrivacy,
                lifecycleFilter: _lifecycleFilter,
                sortField: _sortField,
                sortAscending: _sortAscending,
                pageNumber: _currentPage,
                pageSize: _pageSize,
                cancellationToken: ct);

            if (ct.IsCancellationRequested) return;

            _documents = items.ToList();
            _totalCount = total;
            _totalPages = Math.Max(1, (int)Math.Ceiling((double)total / _pageSize));
        }
        catch (OperationCanceledException)
        {
            // штатная отмена устаревшего запроса
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Ошибка загрузки документов: {ex.Message}", Severity.Error);
        }
        finally
        {
            if (!ct.IsCancellationRequested)
            {
                _isLoading = false;
                _isRefreshing = false;
                StateHasChanged();
            }
        }
    }

    private static readonly (DocumentLifecycleFilter Filter, string Label, string Icon)[] LifecycleOptions =
    [
        (DocumentLifecycleFilter.NotDeleted, "Все (кроме удалённых)", Icons.Material.Filled.List),
        (DocumentLifecycleFilter.ActiveOnly, "Только активные", Icons.Material.Filled.Description),
        (DocumentLifecycleFilter.ArchivedOnly, "В архиве", Icons.Material.Filled.Archive),
        (DocumentLifecycleFilter.DeletedOnly, "Удалённые", Icons.Material.Filled.DeleteOutline)
    ];

    private string GetLifecycleLabel() =>
        LifecycleOptions.FirstOrDefault(x => x.Filter == _lifecycleFilter).Label ?? "Показать";

    private async Task SetLifecycleFilter(DocumentLifecycleFilter filter)
    {
        if (_lifecycleFilter == filter) return;
        _lifecycleFilter = filter;
        await ResetAndReload();
    }
    
    private async Task OnSearchDebounced(string value) => await ResetAndReload();
    private async Task OnSearchKeyUp(KeyboardEventArgs e) { if (e.Key == "Enter") await ResetAndReload(); }
    private async Task OnSearchCleared() { _searchQuery = string.Empty; await ResetAndReload(); }
    private async Task ClearStatusFilter() { _filterStatus = null; await ResetAndReload(); }
    private async Task ClearPrivacyFilter() { _filterPrivacy = null; await ResetAndReload(); }
    private async Task ResetFilters()
    {
        _searchQuery = string.Empty;
        _filterStatus = null;
        _filterPrivacy = null;
        await ResetAndReload();
    }

    private async Task OnStatusFilterChanged(DocumentStatus? value)
    {
        _filterStatus = value;
        await ResetAndReload();
    }

    private async Task OnPrivacyFilterChanged(DocumentPrivacy? value)
    {
        _filterPrivacy = value;
        await ResetAndReload();
    }

    private async Task ResetAndReload()
    {
        _currentPage = 1;
        await LoadData();
    }

    private async Task OnPaginationChanged(int page)
    {
        _currentPage = page;
        await LoadData();
    }
    
    private async Task SetSort(string field)
    {
        if (_sortField == field)
            _sortAscending = !_sortAscending;
        else
        {
            _sortField = field;
            _sortAscending = field != "Date";
        }
        _currentPage = 1;
        await LoadData();
    }

    private async Task ToggleSortDirection()
    {
        _sortAscending = !_sortAscending;
        _currentPage = 1;
        await LoadData();
    }

    private bool IsCurrentSort(string field) => _sortField == field;
    private string GetDirectionIcon() => _sortAscending ? Icons.Material.Filled.ArrowUpward : Icons.Material.Filled.ArrowDownward;
    private string GetSortLabel() => SortOptions.FirstOrDefault(x => x.Field == _sortField).Label ?? "Сортировка";

    private void OpenDocument(Guid id) => Navigation.NavigateTo($"/documents/{id}");
    private void EditDocument(Guid id) => Navigation.NavigateTo($"/documents/{id}/edit");

    private async Task DeleteDocument(DocumentSummaryDto doc)
    {
        var result = await DialogService.ShowMessageBox(
            "Удаление документа",
            $"Вы уверены, что хотите удалить «{doc.Title}»?",
            yesText: "Удалить", cancelText: "Отмена");
        if (result != true) return;

        try
        {
            await DocumentService.DeleteAsync(doc.Id, _currentUserId!.Value);
            Snackbar.Add("Документ удалён", Severity.Warning);
            await LoadData();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task ArchiveDocument(DocumentSummaryDto doc)
    {
        try
        {
            await DocumentService.ToggleArchiveAsync(doc.Id, _currentUserId!.Value);
            Snackbar.Add(doc.ArchivedAtUtc.HasValue ? "Документ восстановлен из архива" : "Документ помещён в архив", Severity.Info);
            await LoadData();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
    private async Task RestoreDocument(DocumentSummaryDto doc)
    {
        try
        {
            await DocumentService.RestoreAsync(doc.Id, _currentUserId!.Value);
            Snackbar.Add("Документ восстановлен", Severity.Success);
            await LoadData();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
    private string GetEmptyStateTitle() => _lifecycleFilter switch
    {
        DocumentLifecycleFilter.ArchivedOnly => "В архиве пока пусто",
        DocumentLifecycleFilter.DeletedOnly => "Нет удалённых документов",
        DocumentLifecycleFilter.ActiveOnly => "Нет активных документов",
        _ => "Документы не найдены"
    };
    
    public void Dispose() => _loadCts?.Cancel();
}